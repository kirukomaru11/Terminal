{
    "app-id" : "io.github.kirukomaru11.Terminal",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "master",
    "sdk" : "org.gnome.Sdk",
    "command" : "terminal",
    "finish-args" : [ "--device=dri", "--talk-name=org.freedesktop.Flatpak", "--socket=wayland" ],
    "modules" : [
        {
            "name" : "vte",
            "buildsystem" : "meson",
            "config-opts" : [ "--buildtype=release", "-Dgtk3=false", "-Dgtk4=true", "-Dglade=false", "-Dgir=true", "-Dvapi=false" ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://download.gnome.org/sources/vte/0.84/vte-0.84.0.tar.xz",
                    "sha256" : "0414e31583836aeb7878da25f67c515f7e8879917ecc37c92e26b83e8d8fc3e3",
                    "x-checker-data" : {
                        "type" : "gnome",
                        "version-scheme" : "odd-minor-is-unstable",
                        "name" : "vte"
                    }
                }
            ]
        },
        {
            "name" : "main",
            "buildsystem" : "simple",
            "build-commands" : [ "mv utils/* .", "env", "python ${FLATPAK_ID##*.}.py --install" ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Terminal.git",
                    "branch" : "main"
                },
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Utils.git",
                    "branch" : "main",
                    "dest" : "utils"
                }
            ]
        }
    ]
}